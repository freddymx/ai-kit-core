{
    "name": "freddymx/ai-kit-core",
    "description": "Core of ai-kit: document ingestion, chunking, extraction, vector retrieval (sqlite-vec + pgvector), and RAG agents built on the official Laravel AI SDK.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alfredo Pineda",
            "email": "freddy@canariasnetworks.com",
            "role": "Developer"
        }
    ],
    "keywords": ["laravel", "ai", "rag", "chatbot", "pgvector", "sqlite-vec", "embeddings"],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "laravel/ai": "^1.4",
        "laravel/prompts": "^0.3.6",
        "smalot/pdfparser": "^2.7"
    },
    "require-dev": {
        "laravel/mcp": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "laravel/mcp": "Expose ai-kit as an MCP server (search/ask/ingest tools) — required only when config('ai-kit.features.mcp') is enabled."
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\AiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\AiKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "laravel": {
            "providers": [
                "SolutionForest\\AiKit\\AiKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
